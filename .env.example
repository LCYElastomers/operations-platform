# Copy to .env and adjust. Never commit .env.
# Docker Compose reads .env automatically for variable substitution.

# Host ports. Both are bound to 127.0.0.1 only.
WEB_PORT=3000
API_PORT=8000

# API runtime. "production" disables the interactive API docs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Host-managed PostgreSQL (SQLAlchemy URL, psycopg 3 driver).
# Leave empty until a database is provisioned. Use a least-privilege
# application role, not a superuser. From inside the api container the
# host is reachable as host.docker.internal.
# Example: postgresql+psycopg://operations_app:<password>@host.docker.internal:5432/operations
DATABASE_URL=
