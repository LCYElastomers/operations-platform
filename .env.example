# Copy to .env and adjust. Never commit .env.
# Docker Compose reads .env automatically for variable substitution.

# Host ports. Both are bound to 127.0.0.1 only.
WEB_PORT=3000
API_PORT=8000

# API runtime. "production" disables the interactive API docs.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Host-managed PostgreSQL (SQLAlchemy URL, psycopg 3 driver).
# Leave empty until a database is provisioned. Use a least-privilege
# application role, not a superuser. From inside the api container the
# host is reachable as host.docker.internal.
# Example: postgresql+psycopg://operations_api:<password>@host.docker.internal:5432/operations_platform
DATABASE_URL=

# Where Moisture Analysis reads from: "fixture" (labeled development data)
# or "database" (current versions in quality.finishing_measurements; requires
# DATABASE_URL and `alembic upgrade head`). Production must use "database";
# "fixture" is refused when ENVIRONMENT=production.
MOISTURE_DATA_SOURCE=fixture

# Machine ingestion endpoints (POST /api/v1/ingestion/...).
#   disabled                    - endpoints answer 503 (default).
#   connector                   - connectors authenticate with X-Connector-Id
#                                 and Authorization: Bearer <secret>. Requires
#                                 INGESTION_CONNECTORS and DATABASE_URL.
#   development-unauthenticated - local development only; refused when
#                                 ENVIRONMENT=production.
INGESTION_AUTH_MODE=disabled

# Connector registry (JSON). Holds SHA-256 digests of secrets, never the
# secrets themselves. Generate a secret and its digest with:
#   uv run python -m app.core.machine_auth new-secret
# List up to 5 digests per connector to rotate without downtime. Example shape:
#   {"lcy-access-sync": {"secret_sha256": ["<64 hex>"], "source_systems": ["access-qryFINISHING-AVG"]}}
INGESTION_CONNECTORS=

# Interactive sign-in (local accounts). Users, roles, role assignments and
# permissions live in the database and are managed in Administration; they
# are never configured here. Create the first administrator with
#   python -m app.auth.cli bootstrap-admin --email <email> --name "<name>"
# (see README, "Users, roles and sign-in").
#
# A session ends after SESSION_IDLE_MINUTES without activity, and in any case
# SESSION_ABSOLUTE_HOURS after sign-in.
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=16
# Send the session cookie over HTTPS only. Must stay true in production (it is
# refused otherwise). Set to false only for local development over plain
# http://localhost.
SESSION_COOKIE_SECURE=true
# Hours a one-time password setup/reset link stays valid.
PASSWORD_LINK_HOURS=72
# Failed sign-ins before an account is locked, and for how many minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# Retired: USER_AUTH_MODE and DEVELOPMENT_USER_PERMISSIONS are ignored (the API
# logs a warning if they are set). Remove them from existing .env files.
